{
  "expo": {
    "name": "RepairTrack",
    "slug": "repair-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/repairtrack-logo.png",
    "scheme": "repairtrack",
    "userInterfaceStyle": "light",

    "ios": {
      "icon": "./assets/images/logo/repairtrack-logo.png"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F6FC",
        "foregroundImage": "./assets/images/logo/repairtrack-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.micomaderia.repairtrack"
    },

    "web": {
      "output": "single",
      "favicon": "./assets/images/logo/repairtrack-logo.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6FC",
          "image": "./assets/images/logo/repairtrack-logo.png",
          "imageWidth": 150
        }
      ],
      "expo-sharing",
      "expo-asset"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a351199d-d12c-462d-bce4-78a6d68f2ca5"
      }
    },

    "owner": "micomaderia"
  }
}
